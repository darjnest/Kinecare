{
  "name": "kinecare-functions",
  "private": true,
  "description": "Cloud Functions de KineCare (reservas, pagos, verificacion)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "npm run build:test && node --test \".test-build/test/unit/**/*.test.js\"",
    "test": "npm run build:test && node --test --test-concurrency=1 \".test-build/test/**/*.test.js\"",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-kinecare \"npm test\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "mercadopago": "^3.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "firebase-tools": "^15.32.1",
    "typescript": "~5.9.0"
  }
}
