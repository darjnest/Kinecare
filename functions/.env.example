# Parametros NO secretos de las Cloud Functions. Copia a functions/.env.<alias-del-proyecto>
# (p. ej. .env.qa). Los secretos van en Secret Manager, nunca aqui:
#   firebase functions:secrets:set MP_CLIENT_SECRET
#   firebase functions:secrets:set MP_WEBHOOK_SECRET
#   firebase functions:secrets:set MP_TOKEN_ENCRYPTION_KEY   # openssl rand -base64 32
MP_APP_ID=
# Opcional: pagina de autorizacion OAuth (por defecto https://auth.mercadopago.cl, la de Chile).
# MP_AUTH_HOST=https://auth.mercadopago.cl

# Verificacion de identidad con Didit. Secretos (Secret Manager):
#   firebase functions:secrets:set DIDIT_API_KEY
#   firebase functions:secrets:set DIDIT_WEBHOOK_SECRET   # `secret_shared_key` del destino de webhook (v3) en la consola de Didit
# UUID del workflow de verificacion (documento + prueba de vida) creado en la consola de Didit.
# Sin este valor `solicitarVerificacion` responde PROVEEDOR_NO_CONFIGURADO.
DIDIT_WORKFLOW_ID=
