rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // fotoUrl la carga Coil en el dispositivo de cualquiera que vea el perfil, asi que no puede ser
    // una URL arbitraria (rastreo de IP). Solo se acepta: nula, la URL de descarga de la propia
    // foto en Storage (`clientes|profesionales/{uid}/foto-perfil.jpg`) o una foto de Google
    // (Google Sign-In la copia al registrarse). El bucket no se fija en la regla: es el mismo
    // archivo para QA y PRD.
    function fotoUrlValida(uid, data) {
      return data.get('fotoUrl', null) == null
        || (data.fotoUrl is string
            && (data.fotoUrl.matches('https://firebasestorage[.]googleapis[.]com/v0/b/[^/]+/o/(clientes|profesionales)%2F'
                  + uid + '%2Ffoto-perfil[.]jpg[?].*')
                || data.fotoUrl.matches('https://lh[0-9][.]googleusercontent[.]com/.*')));
    }

    // `usuarios/{uid}` es PRIVADO: rut, email, correoContacto y telefono solo los lee su dueno (antes
    // cualquier usuario autenticado podia listarlos). Lo que el resto de la app necesita ver de otra
    // persona (nombre y foto) vive en `perfilesPublicos/{uid}`; las Cloud Functions usan Admin SDK.
    // rut, email y fechaRegistro se fijan al registrarse y no se editan: verificacion de identidad
    // compara contra el rut. Crear la cuenta exige reclamar el RUT en `rutsRegistrados` en el mismo
    // batch (getAfter), que es lo que garantiza su unicidad.
    match /usuarios/{usuarioId} {
      allow read: if esDueno(usuarioId);
      allow create: if esDueno(usuarioId)
        && fotoUrlValida(usuarioId, request.resource.data)
        && request.resource.data.rut is string
        && existsAfter(/databases/$(database)/documents/rutsRegistrados/$(request.resource.data.rut))
        && getAfter(/databases/$(database)/documents/rutsRegistrados/$(request.resource.data.rut)).data.uid == usuarioId;
      allow update: if esDueno(usuarioId)
        && request.resource.data.rol == resource.data.rol
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rut', 'email', 'fechaRegistro'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fotoUrl'])
            || fotoUrlValida(usuarioId, request.resource.data));
      allow delete: if false;
    }

    // Nombre y foto de cualquier persona, legibles por todo usuario autenticado (resolver al
    // profesional de una cita, al paciente de una solicitud, al autor de una resena). Solo el
    // dueno lo escribe, con esas dos claves; se mantiene al dia junto con `usuarios/{uid}`.
    function perfilPublicoValido(uid, data) {
      return data.keys().hasOnly(['nombre', 'fotoUrl'])
        && data.keys().hasAll(['nombre'])
        && data.nombre is string && data.nombre.size() >= 1 && data.nombre.size() <= 200
        && fotoUrlValida(uid, data);
    }
    match /perfilesPublicos/{usuarioId} {
      allow read: if request.auth != null;
      allow create, update: if esDueno(usuarioId) && perfilPublicoValido(usuarioId, request.resource.data);
      allow delete: if false;
    }

    // Indice de unicidad del RUT (id = RUT normalizado, sin puntos ni guion). Nadie lo lee: quien
    // intenta registrar un RUT ya tomado falla porque `create` sobre un doc existente es un update,
    // que esta denegado, y el batch completo del registro se rechaza.
    match /rutsRegistrados/{rut} {
      allow read: if false;
      allow create: if request.auth != null
        && rut.matches('[0-9]{6,8}[0-9K]')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Tokens FCM del propio usuario (id del documento = token). Solo el dueno los lee, crea,
    // refresca (re-registrar el mismo token actualiza actualizadoEn) y borra; claves exactas.
    // Quien envia los push es una Cloud Function (Admin SDK), que ignora estas reglas.
    function dispositivoValido(token) {
      return request.resource.data.keys().hasAll(['plataforma', 'actualizadoEn'])
        && request.resource.data.keys().hasOnly(['plataforma', 'actualizadoEn'])
        && request.resource.data.plataforma == 'ANDROID'
        && request.resource.data.actualizadoEn == request.time
        && token.size() >= 1 && token.size() <= 4096;
    }

    match /usuarios/{usuarioId}/dispositivos/{token} {
      allow read: if esDueno(usuarioId);
      allow create, update: if esDueno(usuarioId) && dispositivoValido(token);
      allow delete: if esDueno(usuarioId);
    }

    match /clientes/{usuarioId} {
      allow read, write: if esDueno(usuarioId);
    }

    // Disciplinas por las que filtra la busqueda (TipoAtencion). Sin al menos
    // una, el perfil nunca aparece en resultados.
    function tiposAtencionValidos(data) {
      return data.tiposAtencion is list
        && data.tiposAtencion.size() > 0
        && data.tiposAtencion.size() <= 2
        && data.tiposAtencion.hasOnly(['KINESIOLOGIA', 'MASOTERAPIA']);
    }

    match /profesionales/{usuarioId} {
      allow read: if true;
      // Se crea al registrarse, en el mismo batch que usuarios/{uid} (por eso
      // getAfter), y siempre en estado inicial: sin insignias, sin verificacion
      // y sin reputacion — nadie puede autoasignarse calificacion o insignias.
      allow create: if esDueno(usuarioId)
        && getAfter(/databases/$(database)/documents/usuarios/$(usuarioId)).data.rol == 'PROFESIONAL'
        && request.resource.data.keys().hasAll(['tiposAtencion', 'especialidades', 'rnpi', 'descripcion',
            'calificacionPromedio', 'totalResenas', 'estadoVerificacionGeneral', 'insignias', 'disponibilidad'])
        && request.resource.data.keys().hasOnly(['tiposAtencion', 'especialidades', 'rnpi', 'descripcion',
            'calificacionPromedio', 'totalResenas', 'estadoVerificacionGeneral', 'insignias', 'disponibilidad'])
        && tiposAtencionValidos(request.resource.data)
        && request.resource.data.especialidades is list
        && request.resource.data.rnpi is string
        && request.resource.data.descripcion is string
        && request.resource.data.calificacionPromedio == 0
        && request.resource.data.totalResenas == 0
        && request.resource.data.estadoVerificacionGeneral == 'NO_SOLICITADO'
        && request.resource.data.insignias == []
        && request.resource.data.disponibilidad is list;
      // El dueno solo edita lo que el panel profesional expone: tiposAtencion, especialidades,
      // descripcion y disponibilidad. Todo lo demas lo escriben Cloud Functions (Admin SDK):
      // reputacion (ordena la busqueda), insignias/estadoVerificacionGeneral, mercadoPagoConectado
      // (el callback OAuth; el dueno no puede autoproclamarse "cobrable") y rnpi (lo valida la
      // verificacion, no se autodeclara despues de registrarse). tiposAtencion es opcional en
      // perfiles legados, pero si se toca tiene que quedar valido.
      allow update: if esDueno(usuarioId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['tiposAtencion', 'especialidades', 'descripcion', 'disponibilidad'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tiposAtencion'])
            || tiposAtencionValidos(request.resource.data));
      allow delete: if false;

      // Catalogo del profesional. crearReserva toma de aqui modalidad, duracion y
      // precio, asi que se acotan para que un valor absurdo no llegue al cobro.
      // Pausar/activar (solo `activo`) no revalida el resto: hay servicios
      // sembrados anteriores a estos limites.
      function servicioValido(d) {
        return d.keys().hasAll(['nombre', 'descripcion', 'modalidad', 'duracionMinutos', 'precio', 'activo'])
          && d.nombre is string && d.nombre.size() >= 3 && d.nombre.size() <= 80
          && d.descripcion is string && d.descripcion.size() <= 300
          && d.modalidad in ['DOMICILIO', 'CONSULTA', 'ONLINE']
          && d.duracionMinutos is int && d.duracionMinutos >= 15 && d.duracionMinutos <= 480
          && d.precio is int && d.precio >= 1000 && d.precio <= 1000000
          && d.activo is bool;
      }

      match /servicios/{servicioId} {
        allow read: if true;
        allow create: if esDueno(usuarioId) && servicioValido(request.resource.data);
        allow update: if esDueno(usuarioId)
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activo'])
              || servicioValido(request.resource.data));
        allow delete: if esDueno(usuarioId);
      }

      // Certificaciones que sube el profesional (el archivo va a Storage, ver storage.rules). Solo el
      // dueno las crea y las lee, siempre `EN_REVISION`; aprobar o rechazar (y `motivoRechazo`) lo hace
      // soporte desde la consola con Admin SDK, asi que desde la app no se edita ni se borra nada.
      match /certificaciones/{certificacionId} {
        allow read: if esDueno(usuarioId);
        allow create: if esDueno(usuarioId)
          && request.resource.data.keys().hasOnly(['nombre', 'archivoPath', 'tipoContenido', 'tamanoBytes', 'estado', 'creadoEn'])
          && request.resource.data.keys().hasAll(['nombre', 'archivoPath', 'tipoContenido', 'tamanoBytes', 'estado', 'creadoEn'])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 120
          && request.resource.data.archivoPath is string
          && request.resource.data.archivoPath.matches('profesionales/' + usuarioId + '/certificaciones/[^/]+')
          && request.resource.data.tipoContenido in ['application/pdf', 'image/jpeg', 'image/png']
          && request.resource.data.tamanoBytes is int
          && request.resource.data.tamanoBytes > 0 && request.resource.data.tamanoBytes < 10 * 1024 * 1024
          && request.resource.data.estado == 'EN_REVISION'
          && request.resource.data.creadoEn == request.time;
        allow update, delete: if false;
      }
    }

    match /reservas/{reservaId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.clienteId || request.auth.uid == resource.data.profesionalId);
      // crearReserva/iniciarPago (Cloud Functions, Admin SDK) son el unico camino de escritura.
      allow write: if false;
    }

    // Candados de agenda por profesional: los lee y escribe solo crearReserva (Admin SDK).
    match /bloqueosAgenda/{profesionalId} {
      allow read, write: if false;
    }

    match /pagos/{pagoId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/reservas/$(resource.data.reservaId)).data.clienteId == request.auth.uid ||
        get(/databases/$(database)/documents/reservas/$(resource.data.reservaId)).data.profesionalId == request.auth.uid
      );
      allow write: if false;
    }

    match /resenas/{resenaId} {
      allow read: if true;
      // El id del documento es el reservaId: una segunda resena de la misma reserva
      // seria un update sobre un doc existente, que se deniega mas abajo (evita duplicados).
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.clienteId
        && resenaId == request.resource.data.reservaId
        && request.resource.data.keys().hasAll(['reservaId', 'clienteId', 'profesionalId', 'calificacion', 'fecha'])
        && request.resource.data.keys().hasOnly(['reservaId', 'clienteId', 'profesionalId', 'calificacion', 'comentario', 'fecha'])
        && request.resource.data.calificacion is int
        && request.resource.data.calificacion >= 1
        && request.resource.data.calificacion <= 5
        && request.resource.data.fecha == request.time
        && (!('comentario' in request.resource.data)
            || request.resource.data.comentario == null
            || (request.resource.data.comentario is string && request.resource.data.comentario.size() <= 500))
        && !('respuestaProfesional' in request.resource.data)
        && get(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.estado == 'COMPLETADA'
        && get(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.clienteId == request.auth.uid
        && get(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.profesionalId == request.resource.data.profesionalId;
      // Responder: solo el profesional de la resena (rol leido de usuarios/{uid}), solo la clave
      // respuestaProfesional, una sola vez (no se edita ni se borra), texto 1..500. No toca
      // calificacion/profesionalId, asi que recalcularCalificacion no recalcula.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.profesionalId
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'PROFESIONAL'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuestaProfesional'])
        && (!('respuestaProfesional' in resource.data) || resource.data.respuestaProfesional == null)
        && request.resource.data.respuestaProfesional is string
        && request.resource.data.respuestaProfesional.trim().size() >= 1
        && request.resource.data.respuestaProfesional.size() <= 500;
      allow delete: if false;
    }

    match /reportesProblema/{reporteId} {
      // Mismo truco que resenas: el id es el reservaId, asi un segundo reporte de la
      // misma reserva seria un update (denegado). `resource == null` deja leer un id
      // que todavia no existe, para que el cliente compruebe si ya reporto.
      allow read: if request.auth != null
        && (resource == null || resource.data.clienteId == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.clienteId
        && reporteId == request.resource.data.reservaId
        && request.resource.data.keys().hasAll(['reservaId', 'clienteId', 'profesionalId', 'motivo', 'descripcion', 'estado', 'fecha'])
        && request.resource.data.keys().hasOnly(['reservaId', 'clienteId', 'profesionalId', 'motivo', 'descripcion', 'estado', 'fecha'])
        && request.resource.data.motivo in ['PROFESIONAL_NO_LLEGO', 'ATRASO', 'COBRO_INCORRECTO', 'CONDUCTA_INAPROPIADA', 'CALIDAD_ATENCION', 'OTRO']
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.trim().size() >= 10
        && request.resource.data.descripcion.size() <= 1000
        && request.resource.data.estado == 'ABIERTO'
        && request.resource.data.fecha == request.time
        && get(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.clienteId == request.auth.uid
        && get(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.profesionalId == request.resource.data.profesionalId;
      // El estado (EN_REVISION/RESUELTO) lo cambia soporte desde la consola.
      allow update, delete: if false;
    }

    match /solicitudesVerificacion/{solicitudId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.profesionalId;
      allow write: if false;
    }
  }
}
