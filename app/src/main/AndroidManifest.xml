<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+: permiso en tiempo de ejecucion para mostrar notificaciones (se pide tras iniciar
         sesion y nunca bloquea nada: sin el, la app funciona igual y solo no avisa). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".KineCareApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kinecare">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Kinecare"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Retorno desde el Custom Tab de Mercado Pago (pago y OAuth del profesional) y de
                la verificacion de identidad (Didit, via la funcion HTTPS que redirige aqui).
                `singleTask` entrega estos deep links a la Activity ya abierta (`onNewIntent`)
                en vez de apilar otra. Ver KineCareNavHost.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="pago"
                    android:path="/resultado"
                    android:scheme="kinecare" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="mp"
                    android:scheme="kinecare" />
                <data android:path="/conectado" />
                <data android:path="/error" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="verificacion"
                    android:path="/resultado"
                    android:scheme="kinecare" />
            </intent-filter>
        </activity>

        <!-- Notificaciones push (FCM): token nuevo y mensajes con la app en primer plano. Con la app en
             segundo plano el sistema muestra la notificacion solo, en el canal por defecto de abajo. -->
        <service
            android:name=".push.KineCareMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/canal_citas_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notificacion" />
    </application>

</manifest>