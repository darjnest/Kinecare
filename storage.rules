rules_version = '2';

// Layout y motivos en docs/DATA_MODEL.md#firebase-storage. Todo lo que no
// aparece aqui queda denegado.
service firebase.storage {
  match /b/{bucket}/o {

    // Foto de perfil del profesional: se muestra en su perfil publico (lo
    // lee cualquiera) y solo el dueno la escribe. Sin deletes desde el cliente:
    // reemplazar es sobreescribir. Maximo 5 MB y solo JPEG.
    match /profesionales/{usuarioId}/foto-perfil.jpg {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == usuarioId
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if false;
    }

    // Foto de perfil del cliente. A diferencia de la del profesional no es publica: la lee solo
    // su dueno por ruta. Quien deba verla (usuarios/{uid}.fotoUrl) lo hace con la URL de
    // descarga con token, que no pasa por estas reglas. Escritura: solo el dueno, JPEG, < 5 MB,
    // sin deletes (reemplazar es sobreescribir), igual que la del profesional.
    match /clientes/{usuarioId}/foto-perfil.jpg {
      allow read: if request.auth != null && request.auth.uid == usuarioId;
      allow create, update: if request.auth != null
        && request.auth.uid == usuarioId
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if false;
    }

    // Certificaciones, diplomas y postitulos que sube el profesional (PDF, JPEG o PNG, < 10 MB).
    // Solo el dueno CREA el archivo: no lo lee, no lo reemplaza ni lo borra desde la app (documentos
    // sensibles; los revisa soporte con Admin SDK, que ignora estas reglas). El registro que ve la app
    // es `profesionales/{uid}/certificaciones/{id}` en Firestore.
    match /profesionales/{usuarioId}/certificaciones/{archivo} {
      allow create: if resource == null
        && request.auth != null
        && request.auth.uid == usuarioId
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png']
        && request.resource.size < 10 * 1024 * 1024;
      allow read, update, delete: if false;
    }

    // Documentos de credenciales: contienen datos de identidad/titulos. No los
    // lee ni los escribe la app; los maneja el backend / proveedor de
    // verificacion (Admin SDK ignora estas reglas). Fase 6 define el flujo.
    match /profesionales/{usuarioId}/credenciales/{archivo=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
